datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(cuid())

  email           String?   @unique
  password        String?
  firstName       String?
  lastName        String?
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  vkId     String? @unique
  accounts Account[]

  status UserStatus @default(ACTIVE)
  phone  String?

  country     String?
  citizenship String?

  city String?

  currency Currency @default(USD)

  role Role @default(USER)

  refreshTokens RefreshToken[]
  userDevices   UserDevice[]
  emailTokens   EmailToken[]

  bookings     Booking[]
  transactions Transaction[]
  savedPassengers SavedPassengerProfile[]
  bookingIdempotencyRecords BookingIdempotencyRecord[]
  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model EmailToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose   EmailTokenPurpose
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@index([tokenHash])
  @@index([expiresAt])
}

model SavedPassengerProfile {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  isPrimary Boolean @default(false)

  passengerType PassengerType

  firstName String
  lastName  String
  gender    String

  birthDate   DateTime
  nationality String
  birthPlace  String?

  passportNumber       String
  passportIssuanceDate DateTime
  passportExpiry       DateTime

  email            String?
  phoneCountryCode String?
  phoneNumber      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, passportNumber])
  @@index([userId])
}

model UserNotification {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId     String?
  type          UserNotificationType
  title         String
  message       String
  sourceEventId String?              @unique
  readAt        DateTime?
  createdAt     DateTime             @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model UserDevice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ip        String?
  lastIp    String?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  lastSeen  DateTime @updatedAt
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  deviceInfo String?
  ip         String?

  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason RevokedReason?
  replacedById  String?

  replacedBy RefreshToken? @relation("Replace", fields: [replacedById], references: [id])

  previous RefreshToken[] @relation("Replace")

  userDeviceId String
  userDevice   UserDevice @relation(fields: [userDeviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([userDeviceId])
  @@index([revokedAt])
  @@index([userId, revokedAt])
}

model AirportAlias {
  id String @id @default(cuid())

  airportId String
  airport   Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)

  name String
  lang String?

  @@index([name])
  @@index([airportId])
}

model Airport {
  id String @id @default(cuid())

  name    String
  city    String
  country String

  aliases  AirportAlias[]
  timezone String         @default("UTC")

  iataCode String  @unique @db.VarChar(3)
  icaoCode String? @db.VarChar(4)

  latitude  Float?
  longitude Float?

  // relations
  departingFlights Flight[] @relation("DepartureAirport")
  arrivingFlights  Flight[] @relation("ArrivalAirport")

  departingSegments FlightSegment[] @relation("SegmentDeparture")
  arrivingSegments  FlightSegment[] @relation("SegmentArrival")

  createdAt DateTime @default(now())

  @@index([iataCode])
  @@index([city])
  @@index([name])
}

model Airline {
  id String @id @default(cuid())

  code String @unique
  name String

  aircrafts Aircraft[]

  flights Flight[]

  createdAt DateTime @default(now())
}

model Aircraft {
  id String @id @default(cuid())

  code String  @unique
  name String?

  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])

  segments        FlightSegment[]
  flightInstances FlightInstance[]
  aircraftLayout  AircraftLayout?
}

model Flight {
  id String @id @default(cuid())

  airlineId String
  airline   Airline @relation(fields: [airlineId], references: [id])

  flightNumber String

  departureAirportId String
  departureAirport   Airport @relation("DepartureAirport", fields: [departureAirportId], references: [id])

  arrivalAirportId String
  arrivalAirport   Airport @relation("ArrivalAirport", fields: [arrivalAirportId], references: [id])

  durationMinutes Int

  segments  FlightSegment[]
  instances FlightInstance[]

  createdAt DateTime @default(now())

  @@index([departureAirportId])
  @@index([departureAirportId, arrivalAirportId])
  @@index([arrivalAirportId])
}

model FlightSegment {
  id String @id @default(cuid())

  flightId String
  flight   Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  segmentOrder Int
  dayOffset    Int @default(0)

  departureAirportId String
  departureAirport   Airport @relation("SegmentDeparture", fields: [departureAirportId], references: [id])

  arrivalAirportId String
  arrivalAirport   Airport @relation("SegmentArrival", fields: [arrivalAirportId], references: [id])

  departureTime String
  arrivalTime   String

  carrierCode  String
  flightNumber String

  aircraftId String?
  aircraft   Aircraft? @relation(fields: [aircraftId], references: [id])

  durationMinutes Int

  createdAt DateTime @default(now())

  seatAssignments SeatAssignment[]
  seatHolds       SeatHold[]

  @@index([departureAirportId])
  @@index([arrivalAirportId])
  @@index([flightId, segmentOrder])
}

model FlightInstance {
  id String @id @default(cuid())

  flightId String
  flight   Flight @relation(fields: [flightId], references: [id])

  aircraftId String?
  aircraft   Aircraft? @relation(fields: [aircraftId], references: [id])

  departureDate DateTime

  originalDepartureDate DateTime?

  delayMinutes Int @default(0)

  status FlightStatus @default(SCHEDULED)

  seatsAvailable Int

  seats FlightSeat[]

  fares FlightFare[]

  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([flightId])
  @@index([departureDate])
  @@index([departureDate, flightId])
  @@index([status, departureDate])
}

model FlightFare {
  id String @id @default(cuid())

  flightInstance   FlightInstance @relation(fields: [flightInstanceId], references: [id], onDelete: Cascade)
  flightInstanceId String

  passengerType PassengerType

  travelClass TravelClass

  /// Demo fare family (not ATPCO branded fares).
  fareBrand FareBrand @default(LIGHT)

  basePrice Decimal

  currency Currency

  checkedBags Int @default(0)

  /// Demo commercial rules for the brand (not airline GDS conditions).
  changeable Boolean @default(false)

  refundable Boolean @default(false)

  fareBasis String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flightInstanceId, passengerType, travelClass, fareBrand])
  @@index([flightInstanceId, passengerType, travelClass, fareBrand])
}

model AircraftLayout {
  id String @id @default(cuid())

  aircraftId String   @unique
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id])

  width  Int
  length Int

  seats      SeatTemplate[]
  facilities FacilityTemplate[]
}

model SeatTemplate {
  id       String         @id @default(cuid())
  layoutId String
  layout   AircraftLayout @relation(fields: [layoutId], references: [id])

  number String

  x Int
  y Int

  seatType    SeatType
  travelClass TravelClass @default(ECONOMY)
  deck        Int

  isExitRow      Boolean @default(false)
  isExtraLegroom Boolean @default(false)
  isPremium      Boolean @default(false)

  @@unique([layoutId, x, y])
}

model FacilityTemplate {
  id       String         @id @default(cuid())
  layoutId String
  layout   AircraftLayout @relation(fields: [layoutId], references: [id])

  type FacilityType

  x Int
  y Int

  @@unique([layoutId, x, y])
}

model FlightSeat {
  id String @id @default(cuid())

  flightInstanceId String
  flightInstance   FlightInstance @relation(fields: [flightInstanceId], references: [id], onDelete: Cascade)

  seatNumber String

  x Int
  y Int

  deck Int

  seatType SeatType?

  travelClass TravelClass @default(ECONOMY)

  seatAssignments SeatAssignment[]

  price Decimal @default(0)

  status SeatStatus @default(AVAILABLE)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  seatHolds SeatHold[]

  isExitRow Boolean @default(false)

  isExtraLegroom Boolean @default(false)

  isPremium Boolean @default(false)

  @@unique([flightInstanceId, seatNumber])
  @@unique([flightInstanceId, x, y])
}

model SeatHold {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  flightSeatId String
  seat         FlightSeat @relation(fields: [flightSeatId], references: [id])

  segmentId String
  segment   FlightSegment @relation(fields: [segmentId], references: [id])

  travelerId String
  traveler   Traveler @relation(fields: [travelerId], references: [id])

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@unique([flightSeatId, segmentId])
  @@index([bookingId])
  @@index([expiresAt])
}

model Ticket {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  ticketNumber String @unique

  travelerId String   @unique
  traveler   Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  pdfKey String

  status TicketStatus @default(ISSUED)

  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([bookingId, travelerId])
}

model Booking {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  provider BookingProvider @default(INTERNAL)

  status BookingStatus @default(PNR_CREATED)

  travelers       Traveler[]
  seatAssignments SeatAssignment[]

  tickets Ticket[]

  pnrLocator    String @unique
  flightOrderId String

  lastTicketingDate DateTime
  expiresAt         DateTime

  totalPrice Decimal
  currency   Currency

  snapshot Json

  transaction Transaction?

  flightInstanceId String?
  flightInstance   FlightInstance? @relation(fields: [flightInstanceId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  flightSeats FlightSeat[]
  seatHolds   SeatHold[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model Traveler {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  gender    String
  birthDate DateTime

  nationality String
  birthPlace  String?

  passportNumber       String
  passportIssuanceDate DateTime
  passportExpiry       DateTime

  email            String?
  phoneCountryCode String?
  phoneNumber      String?

  passengerType PassengerType

  accompanyingTravelerId String?
  accompanyingTraveler   Traveler?  @relation("TravelerAccompaniment", fields: [accompanyingTravelerId], references: [id], onDelete: SetNull)
  accompaniedInfants     Traveler[] @relation("TravelerAccompaniment")

  basePrice Decimal
  currency  Currency

  travelClass TravelClass

  fareBasis String?

  checkedBags Int @default(0)

  ticket Ticket?

  seatAssignments SeatAssignment[]

  seatHolds SeatHold[]

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model SeatAssignment {
  id String @id @default(cuid())

  travelerId String
  traveler   Traveler @relation(fields: [travelerId], references: [id])

  flightSeatId String
  seat         FlightSeat @relation(fields: [flightSeatId], references: [id])

  segmentId String
  segment   FlightSegment @relation(fields: [segmentId], references: [id])

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([travelerId, segmentId])
  @@unique([flightSeatId, segmentId])
  @@index([bookingId])
}

model Transaction {
  id String @id @default(cuid())

  idempotencyKey String @unique

  status TransactionStatus @default(PENDING)

  amount   Decimal
  currency Currency

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  provider     PaymentProvider
  externalId   String?
  providerMeta Json?

  paymentExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([externalId])
  @@index([status])
  @@index([paymentExpiresAt])
}

// Immutable domain event log (Kafka audit projection)
model DomainEvent {
  id             String   @id @default(cuid())
  eventId        String
  eventType      String
  aggregateType  String
  aggregateId    String
  bookingId      String?
  payload        Json
  occurredAt     DateTime
  idempotencyKey String   @unique
  kafkaTopic     String
  kafkaPartition Int
  kafkaOffset    String
  createdAt      DateTime @default(now())

  @@index([bookingId, occurredAt])
  @@index([aggregateId, occurredAt])
  @@index([eventType, occurredAt])
}

// CQRS read model: daily booking funnel metrics from domain events
model BookingAnalyticsDaily {
  date              DateTime @id @db.Date
  bookingsCreated   Int      @default(0)
  paymentsSucceeded Int      @default(0)
  paymentsFailed    Int      @default(0)
  bookingsCanceled  Int      @default(0)
  bookingsExpired   Int      @default(0)
  ticketsIssued     Int      @default(0)
  ticketingFailed   Int      @default(0)
  flightsDelayed    Int      @default(0)
  flightsCancelled  Int      @default(0)
  paymentVolume     Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt         DateTime @updatedAt
}

model ProcessedAnalyticsEvent {
  eventId     String   @id
  eventType   String
  occurredAt  DateTime
  processedAt DateTime @default(now())

  @@index([occurredAt])
}

// Outbox table for reliable message publication
model OutboxMessage {
  id String @id @default(cuid())

  aggregateId   String? // optional domain aggregate id (bookingId, etc.)
  aggregateType String? // e.g. Booking

  topic     String // destination topic or exchange
  key       String? // optional partitioning key
  payload   Json // message payload
  transport EnumTransport // KAFKA, RABBITMQ, or INTERNAL
  status    OutboxStatus  @default(PENDING)
  attempts  Int           @default(0)
  lastError String?

  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([aggregateId])
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyOperation {
  id String @id @default(cuid())

  key String

  provider PaymentProvider

  operation String

  status IdempotencyStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, key])
}

model BookingIdempotencyRecord {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  key String

  status IdempotencyStatus

  bookingId String?
  response  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, status])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum FacilityType {
  GALLEY
  LAVATORY
  EXIT
  STAIRS
}

enum SeatType {
  WINDOW
  AISLE
  MIDDLE
}

enum EnumTransport {
  KAFKA
  RABBITMQ
  INTERNAL
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum Provider {
  LOCAL
  VK
  GOOGLE
  GITHUB
  APPLE
}

model Account {
  id String @id @default(cuid())

  provider Provider

  providerAccountId String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  BLOCKED
}

enum UserNotificationType {
  FLIGHT_DELAYED
  FLIGHT_CANCELLED
  BOOKING_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  TICKETING_FAILED
  TICKET_ISSUED
  BOOKING_CANCELED
  BOOKING_EXPIRED
}

enum FlightStatus {
  SCHEDULED
  DELAYED
  CANCELLED
  COMPLETED
}

enum TravelClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

/// Indicative fare families for the internal inventory simulator.
enum FareBrand {
  LIGHT
  FLEX
}

enum PassengerType {
  ADULT
  CHILD
  HELD_INFANT
  SEATED_INFANT
}

enum BookingProvider {
  /// Booking created against local inventory (no external GDS).
  INTERNAL
  MOCK
}

enum BookingStatus {
  PNR_CREATED
  SEATS_SELECTED
  PAYMENT_PENDING
  PAID
  TICKETING
  TICKETED
  CANCELED
  EXPIRED
  FAILED
}

enum TransactionStatus {
  AUTHORIZED
  PENDING
  SUCCEED
  FAILED
  CANCELED
}

enum Currency {
  USD
  EUR
  RUB
}

enum PaymentProvider {
  YOOKASSA
  STRIPE
  STARS
}

enum TicketStatus {
  ISSUED
  VOIDED
  REFUNDED
}

enum Role {
  USER
  ADMIN
}

enum RevokedReason {
  LOGOUT
  REFRESH_ROTATION
  REPLAY_ATTACK
  PASSWORD_CHANGED
  ADMIN
}
