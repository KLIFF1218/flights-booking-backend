{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "globalSetup": "<rootDir>/test/global-setup.e2e.ts",
  "globalTeardown": "<rootDir>/test/global-teardown.e2e.ts",
  "testEnvironment": "node",
  "testTimeout": 120000,
  "forceExit": true,
  "maxWorkers": 1
}
