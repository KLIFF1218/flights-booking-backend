{
  "name": "maxairline-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "nest build swc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:inspect": "NODE_OPTIONS='--inspect' nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "swagger:generate": "ts-node -r tsconfig-paths/register scripts/generate-swagger.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seeds/demo.seed.ts",
    "seed:full": "ts-node -r tsconfig-paths/register scripts/seeds/full.seed.ts",
    "seed:flights": "ts-node -r tsconfig-paths/register scripts/seeds/flights.seed.ts",
    "seed:instances": "ts-node -r tsconfig-paths/register scripts/seeds/flights-instances.seed.ts",
    "seed:refresh-layouts": "ts-node -r tsconfig-paths/register scripts/seeds/refresh-aircraft-layouts.seed.ts",
    "seed:aircraft-layouts": "pnpm seed:refresh-layouts",
    "seed:seat-templates": "ts-node -r tsconfig-paths/register scripts/seeds/seat-templates.seed.ts",
    "seed:cleanup-facilities": "ts-node -r tsconfig-paths/register scripts/seeds/cleanup-facilities.seed.ts",
    "kafka:create-topics": "ts-node scripts/kafka-create-topics.ts",
    "analytics:rebuild": "ts-node -r tsconfig-paths/register scripts/rebuild-analytics.ts",
    "verify:kafka": "bash scripts/verify-kafka-events.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.978.0",
    "@aws-sdk/lib-storage": "^3.978.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "~7.3.0",
    "@sentry/nestjs": "^10.38.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "bullmq": "^5.64.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "ip-range-check": "^0.2.0",
    "kafkajs": "^2.2.4",
    "ms": "^2.1.3",
    "nestjs-pino": "^4.5.0",
    "nestjs-yookassa": "^2.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.1.0",
    "prisma": "^7.4.2",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.36.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1",
    "stripe": "^22.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@testcontainers/postgresql": "^12.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
