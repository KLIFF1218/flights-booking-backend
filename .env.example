# =====================================================
# Flight Booking Backend - Environment Configuration
# =====================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 32
#
# SETUP PROFILES
# --------------
# Docker Compose (app runs inside Docker):
#   POSTGRES_HOST=postgres, REDIS_HOST=redis
#   DATABASE_URL=...@postgres:5432/...
#
# Local Node + Docker infra only (postgres/redis in Docker, app on host):
#   POSTGRES_HOST=localhost, POSTGRES_PORT=5433
#   REDIS_HOST=localhost
#   DATABASE_URL=...@localhost:5433/...

# =====================
# Application Core (required)
# =====================
NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
APP_HOST=http://localhost:3001

# =====================
# API Documentation (optional)
# =====================
# Enable Swagger UI at http://localhost:3001/docs
SWAGGER_ENABLED=true

# =====================
# CORS Configuration (required)
# =====================
# Comma-separated list of allowed frontend origins
HTTP_CORS=http://localhost:3111

# =====================
# Cookies & Security (required)
# =====================
COOKIES_DOMAIN=localhost

# =====================
# Database - PostgreSQL (required)
# =====================
POSTGRES_DB=flight_booking
POSTGRES_USER=admin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Docker Compose profile (default)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:YOUR_POSTGRES_PASSWORD_HERE@postgres:5432/flight_booking

# Local Node profile (uncomment when running app outside Docker)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql://admin:YOUR_POSTGRES_PASSWORD_HERE@localhost:5433/flight_booking

# =====================
# Redis (required)
# =====================
# Docker Compose profile (default)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@redis:6379

# Local Node profile (uncomment when running app outside Docker)
# REDIS_HOST=localhost
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@localhost:6379

# Enable TLS for managed Redis (optional)
REDIS_TLS=false

# =====================
# Authentication - JWT (required)
# =====================
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_EXPIRES_ACCESS_TOKEN=15m
JWT_EXPIRES_REFRESH_TOKEN=7d

# =====================
# VK OAuth Integration (required for VK login)
# =====================
# Get credentials from: https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application
VK_CLIENT_ID=YOUR_VK_CLIENT_ID
VK_CLIENT_SECRET=YOUR_VK_CLIENT_SECRET
VK_GRANT_TYPE=authorization_code
# Must match the redirect URL configured in VK app settings and frontend NEXT_PUBLIC_VK_REDIRECT_URL
VK_REDIRECT_URI=http://localhost:3111


# =====================
# Payment Processing - YooKassa (required for payments)
# =====================
# Optional for local dev if you skip payment flows
# Get from: https://yookassa.ru/
YOOKASSA_SHOP_ID=YOUR_YOOKASSA_SHOP_ID
YOOKASSA_API_KEY=YOUR_YOOKASSA_API_KEY
YOOKASSA_CAPTURE=false

# =====================
# Email Service - SMTP (required for ticket emails)
# =====================
# Optional for local dev; use Mailtrap sandbox for testing
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_LOGIN=YOUR_MAIL_LOGIN
MAIL_PASSWORD=YOUR_MAIL_PASSWORD

# =====================
# Queues - BullMQ (required)
# =====================
QUEUE_PREFIX=dev

# RabbitMQ (optional for async events)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=booking.events
RABBITMQ_QUEUE=booking.ticketing
RABBITMQ_DLX=booking.events.dlx

# Kafka (optional for event streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=flight-booking-consumer
KAFKA_CONSUMER_TOPICS=booking.created,booking.paid,booking.canceled,ticket.issued
KAFKA_TOPICS=booking.created,booking.paid,booking.canceled,ticket.issued

# =====================
# S3 Storage (required for PDF ticket storage)
# =====================
# Optional for local dev if you skip ticketing uploads
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=my-tickets
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_FORCE_PATH_STYLE=true


# =====================
# Error Monitoring - Sentry (optional)
# =====================
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=0

# =====================
# Grafana (optional - Docker Compose only)
# =====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
