# =====================================================
# MaxAirline Backend - Environment Configuration
# =====================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 32
#
# SETUP PROFILES
# --------------
# Docker Compose full stack (recommended — app + infra in Docker):
#   docker compose up -d --build
#   Host overrides for DB/Redis/RabbitMQ are set in docker-compose.yml `environment`.
#
# Local Node + Docker infra only (app on host with pnpm start:dev):
#   POSTGRES_HOST=localhost, POSTGRES_PORT=5433
#   REDIS_HOST=localhost, RABBITMQ_URI=...@localhost:5672
#   docker compose up -d postgres redis rabbitmq minio
#   S3_ENDPOINT=http://localhost:9000 (MinIO — see S3 section below)

# =====================
# Application Core (required)
# =====================
# Docker Compose production image: ghcr.io/${GITHUB_REPOSITORY}:${APP_VERSION}
# Must be lowercase (Docker/GHCR requirement)
GITHUB_REPOSITORY=kliff1218/max-airline

NODE_ENV=development
LOG_LEVEL=info
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
APP_HOST=http://localhost:3001

# =====================
# API Documentation (optional)
# =====================
# Enable Swagger UI at http://localhost:3001/docs (keep false in production)
SWAGGER_ENABLED=true
# Optional OpenAPI server URL shown in Swagger Try-it-out (defaults to APP_HOST or http://localhost:HTTP_PORT)
# SWAGGER_SERVER=http://localhost:3001

# =====================
# Metrics (production)
# =====================
# Required when NODE_ENV=production — protects /metrics (Bearer or X-Metrics-Token header).
# Dev: optional; when unset, /metrics stays open for local Prometheus.
# METRICS_AUTH_TOKEN=openssl rand -base64 32

# =====================
# CORS Configuration (required)
# =====================
# Comma-separated list of allowed frontend origins
# Docker Compose frontend is served at http://localhost (host port 80)
HTTP_CORS=http://localhost,http://localhost:80,http://localhost:3111

# =====================
# Cookies & Security (required)
# =====================
COOKIES_DOMAIN=localhost

# =====================
# Database - PostgreSQL (required)
# =====================
POSTGRES_DB=maxairline
POSTGRES_USER=admin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Docker Compose profile (when app runs inside Docker — uncomment `app` service)
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://admin:YOUR_POSTGRES_PASSWORD_HERE@postgres:5432/maxairline

# Local Node profile (default — infra in Docker, app on host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://admin:YOUR_POSTGRES_PASSWORD_HERE@localhost:5433/maxairline

# =====================
# Redis (required)
# =====================
# Local Node profile (default — infra in Docker, app on host)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@localhost:6379

# Docker Compose profile (when app runs inside Docker)
# REDIS_HOST=redis
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD_HERE@redis:6379

# Enable TLS for managed Redis (optional)
REDIS_TLS=false

# =====================
# Authentication - JWT (required)
# =====================
# Legacy fallback for local/dev only (used when dedicated secrets below are unset).
JWT_SECRET=YOUR_JWT_SECRET_HERE
# Required in production (NODE_ENV=production) — must be set and different from each other.
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE
JWT_EXPIRES_ACCESS_TOKEN=15m
JWT_EXPIRES_REFRESH_TOKEN=7d

# =====================
# VK OAuth Integration (required for VK login)
# =====================
# Get credentials from: https://id.vk.com/about/business/go/docs/ru/vkid/latest/vk-id/connection/create-application
VK_CLIENT_ID=YOUR_VK_CLIENT_ID
VK_CLIENT_SECRET=YOUR_VK_CLIENT_SECRET
VK_GRANT_TYPE=authorization_code
# Must match the redirect URL configured in VK app settings and frontend NEXT_PUBLIC_VK_REDIRECT_URL
VK_REDIRECT_URI=http://localhost


# =====================
# Payment Processing (required for payments)
# =====================
# Default provider — also drives default search currency (STRIPE→USD, YOOKASSA→RUB)
PAYMENT_PROVIDER_DEFAULT=STRIPE

# Stripe — default provider (test mode for local dev)
# 1. Dashboard → Developers → API keys → sk_test_...
# 2. stripe listen --forward-to localhost:3001/api/v1/webhook/stripe → whsec_...
# See README § Full Booking Flow (Stripe Test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend base URL (Stripe/YooKassa redirects + auth email links:
# /auth/verify, /auth/reset-password)
APP_URL=http://localhost

# YooKassa — optional alternative; get credentials from https://yookassa.ru/
# Requires APP_URL (frontend) for return redirect after payment
YOOKASSA_SHOP_ID=
YOOKASSA_API_KEY=
YOOKASSA_CAPTURE=false

# =====================
# Email Service - Resend (required for ticket emails)
# =====================
# Get API key: https://resend.com/api-keys
# Test sender (Resend sandbox): onboarding@resend.dev
# With test sender you can only deliver to the email on your Resend account.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
MAIL_FROM=onboarding@resend.dev

# =====================
# Queues - BullMQ (required)
# =====================
QUEUE_PREFIX=dev

# RabbitMQ (required for async ticketing events)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=YOUR_RABBITMQ_PASSWORD_HERE
RABBITMQ_URI=amqp://admin:YOUR_RABBITMQ_PASSWORD_HERE@localhost:5672
RABBITMQ_EXCHANGE=booking.events
RABBITMQ_QUEUE=booking.ticketing
RABBITMQ_DLX=booking.events.dlx

# Docker Compose profile (when app runs inside Docker)
# RABBITMQ_URI=amqp://admin:YOUR_RABBITMQ_PASSWORD_HERE@rabbitmq:5672

# Kafka (optional for event streaming)
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=max-airline
KAFKA_AUDIT_CONSUMER_GROUP=booking-audit
KAFKA_NOTIFICATIONS_CONSUMER_GROUP=booking-notifications
KAFKA_ANALYTICS_CONSUMER_GROUP=booking-analytics
KAFKA_DOMAIN_TOPICS=booking.created,booking.expired,booking.paid,booking.canceled,booking.ticketing.failed,ticket.issued,payment.failed,payment.reconciliation.refunded,flight.delayed,flight.cancelled

# Docker Compose profile (when app runs inside Docker)
# KAFKA_BROKERS=redpanda:9092

# =====================
# S3 Storage (required for PDF ticket storage)
# =====================
# Local dev — MinIO (docker compose up -d minio; console http://localhost:9001)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# Where the API process reaches storage (localhost if app runs on host)
S3_ENDPOINT=http://localhost:9000
# Host used in browser presigned URLs. Defaults to S3_ENDPOINT if unset.
# When the API runs in Docker, compose sets S3_ENDPOINT=http://minio:9000 and
# S3_PUBLIC_ENDPOINT=http://localhost:9000 so links open in the browser.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=my-tickets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Production / managed S3 (Yandex Cloud, AWS) — usually both endpoints are the same
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=my-tickets
# S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
# S3_SECRET_KEY=YOUR_S3_SECRET_KEY
# S3_FORCE_PATH_STYLE=true


# =====================
# Demo seed (optional — Docker Compose)
# =====================
# When true, app container runs `pnpm seed:demo` after migrations on startup.
SEED_DEMO=false

# =====================
# Foreign exchange rates (optional)
# =====================
# Rates are fetched from FX_API_URL, cached in Redis, and merged with fallbacks.
# Supported currencies: USD, EUR, RUB
FX_API_URL=https://api.frankfurter.app/latest?from=USD
FX_CACHE_TTL_SECONDS=3600
FX_FALLBACK_RATES={"USD":1,"EUR":0.92,"RUB":90}

# =====================
# Round-trip turnaround (optional)
# =====================
MIN_DOMESTIC_TURNAROUND_MINUTES=120
MIN_INTERNATIONAL_TURNAROUND_MINUTES=180

# =====================
# Fare taxes and fees (optional)
# =====================
# Applied on top of DB base fares for search/pricing breakdowns.
FARE_TAX_YQ_RATE=0.08
FARE_TAX_YR_RATE=0.05
BOOKING_SERVICE_FEE=5

# =====================
# Error Monitoring - Sentry (optional)
# =====================
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=0

# =====================
# Grafana (optional - Docker Compose only)
# =====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
